# Local development only. PostgreSQL is reachable only on the Compose network.
COMPOSE_PROJECT_NAME=docintel-bench
API_PORT=8000
FRONTEND_PORT=3000
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Blank generates a private session key in the persistent application volume.
SECRET_KEY=
SEED_ON_REGISTER=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WEBHOOK_SIGNING_KEY=
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE=false
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
